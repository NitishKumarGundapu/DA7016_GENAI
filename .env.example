# Copy to .env and fill in the values you need.

# Provider used for text work: "ollama" (local) or "openrouter" (cloud).
LLM_PROVIDER=ollama

# Required for PDF/image OCR and for OpenRouter grading.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_VISION_MODEL=mistralai/mistral-small-3.1-24b-instruct

# Ollama settings (used when LLM_PROVIDER=ollama).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_NUM_CTX=8192

# Grading robustness.
USE_CRITIC=true
MAX_GRADE_RETRIES=2
EXTRACTION_REASONING=false

# Optional LangSmith tracing and evaluation.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=auto-assessment

# Docker Compose only: use this to point the container at Ollama running in
# another Compose service, e.g. http://ollama:11434.
# DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
